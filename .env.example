# ── Runtime ──
LOG_LEVEL=info

# ── API ──
API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# ── Web ──
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Data stores (match docker-compose.yml) ──
DATABASE_URL=postgres://soccalytics:soccalytics@localhost:5433/soccalytics
REDIS_URL=redis://localhost:6380
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=soccalytics
S3_ACCESS_KEY_ID=soccalytics
S3_SECRET_ACCESS_KEY=soccalytics-secret

# ── AI ──
# Leave unset to run with deterministic offline fallbacks (reports are templated).
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium

# ── Observability ──
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=soccalytics
